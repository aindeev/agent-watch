# Copy to .env (chmod 600). Never commit .env.
USER_NAME=Alex                 # what the voice agent calls you
TO_NUMBER=+15555550123         # your phone, E.164
ELEVENLABS_API_KEY=sk_...
TELNYX_API_KEY=KEY...
# Optional: link "#1234" in summaries to your PRs
# PR_LINK=https://github.com/your-org/your-repo/pull/
# Filled in by provision_telnyx.py and create_agent.py:
# TELNYX_OVP_ID= TELNYX_CONN_ID= TELNYX_SIP_USER= TELNYX_SIP_PASS= TELNYX_NUMBER= EL_PHONE_ID= EL_AGENT_ID=
# No calls during these local hours (may wrap past midnight). Remove to allow calls any time.
QUIET_HOURS=21:00-08:00
# Paseo agent id (prefix ok) of the coordinator session, so it and agents it starts are not tracked
# COORDINATOR_AGENT=
# Names the voice agent should recognise (comma separated)
# VOICE_KEYWORDS=

# --- Optional extras ---
# Phone calls through OpenAI's realtime model (voice/realtime_bridge.py); falls back to ElevenLabs when it's down
# OPENAI_API_KEY=sk-...
# CALL_ENGINE=auto                # auto: the calling CLI below if configured and it accepts, else OpenAI realtime,
#                                 # else ElevenLabs. Or force: cli | realtime | elevenlabs
# Optional external calling CLI (e.g. your team's internal tooling that places calls with shared keys). It's run as
#   <CALL_CLI> <op> --input '<json>' --json --no-input   and must print {"ok": true, "data": {...}}
# CALL_CLI="mytool ops run"
# CALL_CLI_PLACE=calls.place      # {agentId, toNumber, dynamicVariables} -> {conversationId}
# CALL_CLI_GET=calls.get          # {conversationId} -> {done, transcript: [{role, message}], dataCollection: {answers: {value}}}
# CALL_CLI_AGENT_ID=agent_...     # the voice agent it should use (defaults to EL_AGENT_ID)
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin
# TELNYX_CC_APP_ID=...            # Telnyx Call Control app used by the realtime bridge
# Machine upkeep (resources.py): the main checkout whose worktrees agents create, its GitHub repo, and the
# Docker compose project prefix of its dev stacks
# CLEANUP_REPO=/path/to/your/repo
# CLEANUP_GH_REPO=your-org/your-repo
# STACK_PREFIX=yourrepo-
# DISK_MIN_GB=150
# STACK_IDLE_HOURS=6
# LOAD_OVERLOAD_X=4
# A held question (coord.py hold, or "Later" in the menu bar) is called about again after this many hours
# HOLD_HOURS=3
# Where dashboard/gen.py writes the HTML dashboard (default dashboard/index.html)
# DASHBOARD_OUT=~/agents-dashboard/index.html
